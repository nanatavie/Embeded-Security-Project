 267:.././simpleserial/simpleserial.c **** uint8_t ss_num_commands(uint8_t *x, uint8_t len)
 268:.././simpleserial/simpleserial.c **** {
 269:.././simpleserial/simpleserial.c ****     uint8_t ncmds = num_commands & 0xFF;
 270:.././simpleserial/simpleserial.c ****     simpleserial_put('r', 0x01, &ncmds);
 271:.././simpleserial/simpleserial.c ****     return 0x00;
 272:.././simpleserial/simpleserial.c **** }
 273:.././simpleserial/simpleserial.c **** 
 274:.././simpleserial/simpleserial.c **** typedef struct ss_cmd_repr {
 275:.././simpleserial/simpleserial.c ****     uint8_t c;
 276:.././simpleserial/simpleserial.c ****     uint8_t len;
 277:.././simpleserial/simpleserial.c ****     uint8_t flags;
 278:.././simpleserial/simpleserial.c **** } ss_cmd_repr;
